rules_version = '2';

// match 경로 리터럴은 ASCII 식별자만 허용되어 한글 컬렉션명을 바로 쓸 수 없다.
// 와일드카드로 컬렉션명을 받아 문자열 비교로 분기한다.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{collection}/{docId} {
      // `공개`: 봇이 조회하는 유일한 소스. 읽기는 공개, 쓰기는 검수 페이지/admin만.
      // `검수대기`: Vision 추출 후보. 인증된 운영자만 접근.
      allow read: if collection == '공개'
        || (collection == '검수대기' && request.auth != null);
      allow write: if collection == '검수대기' && request.auth != null;
    }
  }
}
