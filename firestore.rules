rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // 봇이 조회하는 유일한 소스. 읽기는 공개, 쓰기는 검수 페이지/admin만.
    match /공개/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // Vision 추출 후보. 인증된 운영자만 접근.
    match /검수대기/{docId} {
      allow read, write: if request.auth != null;
    }
  }
}
